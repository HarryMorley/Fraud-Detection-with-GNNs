T13:43:00.577472Z","shell.execute_reply.started":"2025-08-15T13:41:49.913704Z","shell.execute_reply":"2025-08-15T13:43:00.576745Z"}},"outputs":[{"name":"stdout","text":"Edges: 5,078,345 | Nodes: 515,080 | Feat dim: 7 | Vocabs: {'Payment Currency': 15, 'Payment Format': 7}\n","output_type":"stream"}],"execution_count":4},{"cell_type":"code","source":"class TimeEncoder(nn.Module):\n    \"\"\"Simple harmonic time encoder for seconds since epoch (int64).\"\"\"\n    def __init__(self, dim: int):\n        super().__init__()\n        self.dim = dim\n        freq = torch.exp(torch.linspace(math.log(1e-4), math.log(1e2), dim))\n        self.register_buffer(\"freq\", freq, persistent=False)\n\n    def forward(self, t: torch.Tensor) -> torch.Tensor:\n        # t: (B,) on same device\n        t = t.float().unsqueeze(1) * self.freq.unsqueeze(0)  # (B, dim)\n        return torch.cat([torch.sin(t), torch.cos(t)], dim=1)  # (B, 2*dim)\n\ndef hard_reset_tgn_memory(mem, device: torch.device):\n    # Lightweight reset: move & let PyG create empty, device-correct stores\n    mem = mem.to(device)\n    mem.reset_state()\n    return mem\n\nclass MessageMLP(nn.Module):\n    \"\"\"\n    Must match PyG TGN call:\n      forward(m_src, m_dst, raw_msg, t_enc)\n    where:\n      m_src, m_dst: (B, memory_dim)\n      raw_msg:      (B, raw_msg_dim)\n      t_enc:        (B, time_dim)  # already encoded by TGNMemory\n    \"\"\"\n    def __init__(self, mem_dim: int, raw_msg_dim: int, time_dim: int):\n        super().__init__()\n        in_dim = 2 * mem_dim + raw_msg_dim + time_dim\n        self.fc = nn.Sequential(\n            nn.Linear(in_dim, mem_dim),\n            nn.ReLU(),\n            nn.Linear(mem_dim, mem_dim),\n        )\n        self.out_channels = mem_dim\n\n    def forward(self, m_src, m_dst, raw_msg, t_enc):\n        return self.fc(torch.cat([m_src, m_dst, raw_msg, t_enc], dim=1))\n\n\nclass FraudTGN(nn.Module):\n    \"\"\"\n    TGN-style architecture with:\n      - embeddings for categorical edge fields (Payment Currency/Format)\n      - raw edge feature concat\n      - TGNMemory for node states\n      - edge scoring via MLP on [m_src, m_dst, raw_msg]\n    NOTE: Memory update is executed outside the forward in the training loop utils.\n    \"\"\"\n    def __init__(self,\n                 num_nodes: int,\n                 edge_feat_dim: int,\n                 vocabs: Dict[str, int],\n                 emb_dim: int = 16,\n                 mem_dim: int = 128,\n                 time_dim: int = 16):\n        super().__init__()\n        self.emb_pc = nn.Embedding(vocabs[\"Payment Currency\"], emb_dim)\n        self.emb_pf = nn.Embedding(vocabs[\"Payment Format\"], emb_dim)\n        self.raw_msg_dim = edge_feat_dim + 2*emb_dim\n        self.memory = TGNMemory(\n            num_nodes=num_nodes,\n            raw_msg_dim=self.raw_msg_dim,\n            memory_dim=mem_dim,\n            time_dim=time_dim,\n            message_module=MessageMLP(mem_dim, self.raw_msg_dim, time_dim),\n            aggregator_module=LastAggregator()\n        )\n        self.mlp = nn.Sequential(\n            nn.Linear(2*mem_dim + self.raw_msg_dim, mem_dim),\n            nn.ReLU(),\n            nn.Linear(mem_dim, 1),\n        )\n\n    def _align_memory_device(self):\n        dev = next(self.parameters()).device\n        self.memory = self.memory.to(dev)\n\n    def forward(self, src, dst, t, edge_attr, **cats):\n        self._align_memory_device()  # keep memory in lockstep with model\n\n        pc, pf = cats[\"Payment Currency\"], cats[\"Payment Format\"]\n        raw_msg = torch.cat([edge_attr, self.emb_pc(pc), self.emb_pf(pf)], dim=1)\n\n        # Read current memories (no mutation here)\n        m_src, _ = self.memory(src)\n        m_dst, _ = self.memory(dst)\n        m_src = m_src.detach()\n        m_dst = m_dst.detach()\n\n        score = self.mlp(torch.cat([m_src, m_dst, raw_msg], dim=1)).squeeze(-1)\n        return score, raw_msg\n\n# (Optional) A light baseline with no memory; node embeddings + edge MLP\nclass EdgeMLP(nn.Module):\n    \"\"\"\n    Baseline: static node embeddings + edge MLP over [u, v, edge_attr, cat_embs].\n    Useful as a sanity check and for ablations.\n    \"\"\"\n    def __init__(self, num_nodes: int, edge_feat_dim: int, vocabs: Dict[str, int],\n                 emb_dim_nodes: int = 64, emb_dim_cat: int = 16, hidden: int = 128):\n        super().__init__()\n        self.node_emb = nn.Embedding(num_nodes, emb_dim_nodes)\n        self.emb_pc   = nn.Embedding(vocabs[\"Payment Currency\"], emb_dim_cat)\n        self.emb_pf   = nn.Embedding(vocabs[\"Payment Format\"], emb_dim_cat)\n        in_dim = 2*emb_dim_nodes + edge_feat_dim + 2*emb_dim_cat\n        self.mlp = nn.Sequential(\n            nn.Linear(in_dim, hidden),\n            nn.ReLU(),\n            nn.Linear(hidden, 1)\n        )\n        self.raw_msg_dim = edge_feat_dim + 2*emb_dim_cat  # for API compatibility\n        self.memory = None  # utils will skip memory ops\n\n    def forward(self, src, dst, t, edge_attr, **cats):\n        dev = next(self.parameters()).device\n        assert edge_attr.device == dev and src.device == dev and dst.device == dev, \\\n            f\"Model on {dev}, got src={src.device}, dst={dst.device}, x={edge_attr.device}\"\n\n        pc, pf = cats[\"Payment Currency\"], cats[\"Payment Format\"]\n        u = self.node_emb(src)\n        v = self.node_emb(dst)\n        cat = torch.cat([self.emb_pc(pc), self.emb_pf(pf)], dim=1)\n        raw_msg = torch.cat([edge_attr, cat], dim=1)\n        score = self.mlp(torch.cat([u, v, raw_msg], dim=1)).squeeze(-1)\n        return score, raw_msg\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-08-15T14:14:24.889120Z","iopub.execute_input":"2025-08-15T14:14:24.889908Z","iopub.status.idle":"2025-08-15T14:14:24.907564Z","shell.execute_reply.started":"2025-08-15T14:14:24.889881Z","shell.execute_reply":"2025-08-15T14:14:24.906920Z"}},"outputs":[],"execution_count":11},{"cell_type":"code","source":"# Add more models here as you iterate (e.g., a GAT encoder replacing memory, etc.)\n\n# %% [markdown]\n# ## 6) Training config & loop\n\n# %% [code]\nBS      = 4096\nEPOCHS  = 10\nLR      = 1e-4\nWD      = 1e-5\nPATIENCE= 2\n\ndef make_model(model_name: str):\n    if model_name == \"FraudTGN\":\n        return FraudTGN(\n            num_nodes=num_nodes,\n            edge_feat_dim=pack.feat_dim,\n            vocabs=pack.vocabs,\n            emb_dim=16, mem_dim=128, time_dim=16\n        ).to(DEVICE)\n    elif model_name == \"EdgeMLP\":\n        return EdgeMLP(\n            num_nodes=num_nodes,\n            edge_feat_dim=pack.feat_dim,\n            vocabs=pack.vocabs,\n            emb_dim_nodes=64, emb_dim_cat=16, hidden=128\n        ).to(DEVICE)\n    else:\n        raise ValueError(f\"Unknown model: {model_name}\")\n\nMODELS_TO_TRY = [\"FraudTGN\", \"EdgeMLP\"]  # extend this list freely","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-08-15T13:43:00.594774Z","iopub.execute_input":"2025-08-15T13:43:00.595496Z","iopub.status.idle":"2025-08-15T13:43:00.617547Z","shell.execute_reply.started":"2025-08-15T13:43:00.595478Z","shell.execute_reply":"2025-08-15T13:43:00.617006Z"}},"outputs":[],"execution_count":6},{"cell_type":"code","source":"# ## 7) Cross-validation run\n\n# %% [code]\ndef evaluate_slice(y_true, y_pred):\n    y_true = y_true.numpy()\n    y_pred = y_pred.numpy()\n    return dict(\n        roc_auc = skm.roc_auc_score(y_true, y_pred),\n        pr_auc  = skm.average_precision_score(y_true, y_pred)\n    )\n\nresults = {}\nfor name in MODELS_TO_TRY:\n    print(f\"\\n================= {name} =================\")\n    cv_auc, cv_aupr = [], []\n\n    for k, f in enumerate(folds, 1):\n        t0 = time.perf_counter()\n        print(f\"\\n── Fold {k} │ train={f['train_slice'].stop} │ \"\n              f\"val={f['val_slice'].stop - f['val_slice'].start} │ \"\n              f\"test={f['test_slice'].stop - f['test_slice'].start} ──\")\n\n        model = make_model(name)\n\n        # --- one-time init: move memory & start clean (light reset) ---\n        if getattr(model, \"memory\", None) is not None:\n            model.memory = model.memory.to(DEVICE)\n            model.memory.reset_state()\n\n        pos_w  = compute_pos_weight(pack.y, f[\"train_slice\"]).to(DEVICE)\n        crit   = nn.BCEWithLogitsLoss(pos_weight=pos_w)\n        opt    = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=WD)\n        sched  = torch.optim.lr_scheduler.ReduceLROnPlateau(opt, mode=\"min\", factor=0.5, patience=PATIENCE)\n\n        last_lr = opt.param_groups[0][\"lr\"]\n        for epoch in range(1, EPOCHS+1):\n            ep0 = time.perf_counter()\n\n            # ---- TRAIN ----\n            model.train()  # OK for TGN; does not flush\n            tr_pred, tr_true, tr_loss = run_epoch_streaming(\n                model, pack, f[\"train_slice\"], crit, opt, BS, DEVICE\n            )\n\n            # ---- VALIDATION (no heavy reset inside utils) ----\n            with torch.no_grad():\n                if getattr(model, \"memory\", None) is not None:\n                    # Light reset here; DO NOT call model.eval() for TGN\n                    model.memory = model.memory.to(DEVICE)\n                    model.memory.reset_state()\n                    va_pred, va_true, va_loss = run_epoch_streaming(\n                        model, pack, f[\"val_slice\"], crit, None, BS, DEVICE,\n                        memory_reset_on_eval=False  # <<< IMPORTANT\n                    )\n                else:\n                    # Non-TGN models use normal eval()\n                    model.eval()\n                    va_pred, va_true, va_loss = run_epoch_streaming(\n                        model, pack, f[\"val_slice\"], crit, None, BS, DEVICE,\n                        memory_reset_on_eval=False\n                    )\n                    model.train()\n\n            tr_m = evaluate_slice(tr_true, tr_pred)\n            va_m = evaluate_slice(